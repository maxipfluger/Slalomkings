<?xml version="1.0"?>
<package format="3">
  <name>slalom</name>
  <version>0.1.0</version>
  <description>Slalom nodes for Team 13 (Slalomkings)</description>
  <maintainer email="team13@ucsd.edu">Slalomkings</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>slalom_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
